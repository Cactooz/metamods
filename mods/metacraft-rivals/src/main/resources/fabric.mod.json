{
	"schemaVersion": 1,
	"id": "metacraft-rivals",
	"version": "${version}",
	"name": "Metacraft Rivals",
	"description": "Splatoon-style paint prototype for vanilla clients, via Polymer. Players only need the auto-served resource pack.",
	"authors": [
		"Edvin"
	],
	"contact": {
		"sources": "${git_repo}",
		"homepage": "${website}",
		"issues": "${issues}"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nu.metacraft.rivals.Rivals"
		],
		"fabric-gametest": [
			"nu.metacraft.rivals.gametest.RivalsGameTests"
		]
	},
	"mixins": [
		"metacraft-rivals.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": "*",
		"polymer-virtual-entity": "*",
		"polymer-resource-pack": "*",
		"polymer-autohost": "*",
		"sgui": "*"
	}
}
